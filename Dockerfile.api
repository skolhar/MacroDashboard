FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils && rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir -r requirements.txt
COPY apps apps
COPY packages packages
COPY config config
COPY db db
COPY scripts scripts
COPY alembic.ini .
CMD ["sh", "-c", "if [ \"$APP_ENV\" = demo ] || [ \"$APP_ENV\" = development ]; then alembic upgrade head || exit 1; fi; python -m packages.jobs.sync_registry && python -m packages.jobs.seed && uvicorn apps.api.main:app --host 0.0.0.0 --port 8000"]

# Never reuse a production password. Keep the completed file outside Git.
STAGING_POSTGRES_PASSWORD=
STAGING_DATABASE_URL=postgresql+psycopg://staging_macro:<url-encoded-password>@db:5432/staging_macro
# Optional: private UI access uses a research:read-only operator credential.
# Keep staging bound to loopback and rotate this token.
STAGING_RESEARCH_OPERATOR_TOKEN=
STAGING_RESEARCH_UI_USER=
STAGING_RESEARCH_UI_PASSWORD=
